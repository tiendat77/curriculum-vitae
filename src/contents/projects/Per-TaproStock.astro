---
import Project from '@/components/Project.astro';

import AngularIcon from "@/icons/angular.astro";
import AstroIcon from "@/icons/astro.astro";
import TailwindIcon from "@/icons/tailwind.astro";
import MaterialIcon from '@/icons/material.astro';
import SignalrIcon from '@/icons/signalr.astro';
import DotnetIcon from '@/icons/dotnet.astro';
import SqlIcon from '@/icons/sql.astro';
import NodeJSIcon from '@/icons/node.astro';
import PostgreIcon from '@/icons/postgre.astro';
import ReactIcon from '@/icons/react.astro';
import DaisyuiIcon from '@/icons/daisyui.astro';
---

<Project
  name="Tapro Stock"
  link="taprostock.vn"
  href="https://taprostock.vn/"
  type="Freelance"
  year="2023-2024"
>
  <article class="mt-2 text-sm">
    <p>
      A stock-investing community platform where members discuss ideas, share strategies, and learn from Tapro's coaches instead of relying on scattered Facebook groups and ad-hoc chat threads.
    </p>

    <p>
      Beyond the forum, Tapro Stock centralizes course sales, member support, and in-house analysis tools so retail investors can make more informed decisions instead of reacting blindly to market noise.
    </p>

    <p>
      Core sub-projects:
    </p>

    <ul class="flex flex-col gap-4 list-disc pl-4">
      <li>
        <h6 class="mb-1">
          <a
            target="_blank"
            href="https://taprostock.vn/"
            class="text-primary"
          >
            Tapro Landing Page
          </a>
        </h6>

        <p>
          A fast, server-side rendered marketing site that introduces the community, courses, and toolset, and channels visitors into the forum and learning experience.
        </p>

        <ul class="flex flex-wrap gap-2 mt-4">
          <li class="badge badge-primary print:!bg-transparent">
            <AstroIcon />
            <span>Astro</span>
          </li>

          <li class="badge badge-primary print:!bg-transparent">
            <ReactIcon />
            <span>React</span>
          </li>

          <li class="badge badge-primary print:!bg-transparent">
            <TailwindIcon />
            <span>TailwindCSS</span>
          </li>

          <li class="badge badge-primary print:!bg-transparent">
            <DaisyuiIcon />
            <span>DaisyUI</span>
          </li>
        </ul>
      </li>

      <li>
        <h6 class="mb-1">
          <a
            target="_blank"
            href="https://app.taprostock.vn/home"
            class="text-primary"
          >
            Tapro Forum & Tools
          </a>
        </h6>

        <p>
          The main app that brings together discussion forums, e-learning content, and interactive tools for screening and analyzing stocks.
        </p>

        <ul class="flex flex-wrap gap-2 mt-4">
          <li class="badge badge-primary print:!bg-transparent">
            <AngularIcon />
            <span>Angular 15</span>
          </li>

          <li class="badge badge-primary print:!bg-transparent">
            <MaterialIcon />
            <span>Material</span>
          </li>

          <li class="badge badge-primary print:!bg-transparent">
            <TailwindIcon />
            <span>TailwindCSS</span>
          </li>

          <li class="badge badge-primary print:!bg-transparent">
            <SignalrIcon />
            <span>SignalR</span>
          </li>
        </ul>
      </li>

      <li>
        <h6 class="mb-1">
          <a class="text-primary">
            Tapro Crawling Tool
          </a>
        </h6>

        <p>
          An internal automation service that crawls market data and persists it for Tapro's analysis and in-house indicators.
        </p>

        <ul class="flex flex-wrap gap-2 mt-4">
          <li class="badge badge-primary print:!bg-transparent">
            <NodeJSIcon />
            <span>NodeJs</span>
          </li>

          <li class="badge badge-primary print:!bg-transparent">
            <PostgreIcon />
            <span>PostgreSQL</span>
          </li>
        </ul>
      </li>

      <li>
        <h6 class="mb-1">
          <a class="text-primary">
            Tapro API <small class="text-neutral">(not my work)</small>
          </a>
        </h6>

        <p>
          A RESTful API that provide data for the forum, the e-learning, and the tools.
        </p>

        <ul class="flex flex-wrap gap-2 mt-4">
          <li class="badge badge-primary print:!bg-transparent">
            <DotnetIcon />
            <span>Net Core</span>
          </li>

          <li class="badge badge-primary print:!bg-transparent">
            <SignalrIcon />
            <span>SignalR</span>
          </li>

          <li class="badge badge-primary print:!bg-transparent">
            <SqlIcon />
            <span>SQL Server</span>
          </li>
        </ul>
      </li>
    </ul>
  </article>
</Project>
