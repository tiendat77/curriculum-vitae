---
import Project from '@/components/Project.astro';

import AngularIcon from "@/icons/angular.astro";
import MaterialIcon from '@/icons/material.astro';
---

<Project
  name="Leanwell MOM/MES"
  link=""
  href=""
  type="Leanwell"
  year="2019 - 2022"
>
  <article class="mt-2 text-sm">
    <p>
      A manufacturing operations management (MOM/MES) suite that replaces paper forms and siloed spreadsheets on the shop floor. Plants track production orders, labor, and catering services in one system instead of reconciling data across disconnected tools.
    </p>

    <p>
      Supervisors get real‑time views of line performance and staffing, so they can react quickly to issues, reduce downtime, and improve overall throughput.
    </p>

    <ul class="flex flex-wrap gap-2 mt-2">
      <li class="badge badge-primary print:!bg-transparent">
        <AngularIcon />
        <span>Angular 10</span>
      </li>

      <li class="badge badge-primary print:!bg-transparent">
        <MaterialIcon />
        <span>MaterialUI</span>
      </li>
    </ul>
  </article>
</Project>
