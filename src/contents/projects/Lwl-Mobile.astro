---
import Project from '@/components/Project.astro';

import AngularIcon from "@/icons/angular.astro";
import CapacitorIcon from '@/icons/capacitor.astro';
import MaterialIcon from '@/icons/material.astro';
---

<Project
  name="Leanwell Mobile App"
  link=""
  href=""
  type="Leanwell"
  year="2019 - 2022"
>
  <article class="mt-2 text-sm">
    <p>
      Hybrid apps for industrial tablets and mobile phones that bring MOM/MES workflows directly to the shop floor.
    </p>

    <p>
      Operators use the apps to check in/out, view their shifts, order catering meals, and capture quality data at each station, so events are recorded in real time instead of after the fact.
    </p>

    <ul class="flex flex-wrap gap-2 mt-2">
      <li class="badge badge-primary print:!bg-transparent">
        <AngularIcon />
        <span>Angular 10</span>
      </li>

      <li class="badge badge-primary print:!bg-transparent">
        <MaterialIcon />
        <span>MaterialUI</span>
      </li>

      <li class="badge badge-primary print:!bg-transparent">
        <CapacitorIcon />
        <span>CapacitorJS</span>
      </li>
    </ul>
  </article>
</Project>
