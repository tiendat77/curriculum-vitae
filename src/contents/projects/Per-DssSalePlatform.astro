---
import Project from '@/components/Project.astro';

import AngularIcon from "@/icons/angular.astro";
import TailwindIcon from "@/icons/tailwind.astro";
import NextIcon from '@/icons/next.astro';
import HeroUiIcon from '@/icons/hero-ui.astro';
import DotnetIcon from '@/icons/dotnet.astro';
import SqlIcon from '@/icons/sql.astro';
import NgZorroIcon from '@/icons/ng-zorro.astro';
import SignalrIcon from '@/icons/signalr.astro';
---

<Project
  name="DSS Sale Platform"
  link="dss.com"
  href="https://khotot.vn/"
  type="Freelance"
  year="2025-2026"
>
  <article class="mt-2 text-sm">
    <p>
      A multi-tenant sales platform that unifies how DSS and master-dealers sell cameras online, replacing spreadsheets and manual order workflows with a single, trackable system.
    </p>

    <p>
      I joined as a freelance front-end engineer to design and implement the web across three applications, collaborating with the back-end team and integrating into their .NET + SQL stack.
    </p>

    <p>
      I also owned deployment end to end, setting up GitHub Actions pipelines that build and ship the applications to Portainer so changes move from commit to production with minimal manual work.
    </p>

    <p>
      Live at
      <a
        target="_blank"
        href="https://khotot.vn/"
        class="text-primary"
      >
        khotot.vn
      </a>
      and its admin tools are actively used by DSS sales teams to manage catalog, pricing, promotions, and orders.
    </p>

    <p>
      Core sub-projects:
    </p>

    <ul class="flex flex-col gap-4 list-disc pl-4">
      <li>
        <h6 class="mb-1">
          <a
            target="_blank"
            href="https://dss.khotot.vn/"
            class="text-primary"
          >
            DSS Admin
          </a>
        </h6>

        <p>
          An internal dashboard for DSS operators to manage the full catalog (products, price tiers), configure promotions, and monitor orders and customer activity in real time.
        </p>

        <ul class="flex flex-wrap gap-2 mt-2">
          <li class="badge badge-primary print:!bg-transparent">
            <AngularIcon />
            <span>Angular 20</span>
          </li>

          <li class="badge badge-primary print:!bg-transparent">
            <TailwindIcon />
            <span>TailwindCSS 4</span>
          </li>

          <li class="badge badge-primary print:!bg-transparent">
            <NgZorroIcon />
            <span>Ng Zorro</span>
          </li>

          <li class="badge badge-primary print:!bg-transparent">
            <SignalrIcon />
            <span>SignalR</span>
          </li>
        </ul>
      </li>

      <li>
        <h6 class="mb-1">
          <a
            target="_blank"
            href="https://md.khotot.vn/"
            class="text-primary"
          >
            Master Dealer Admin
          </a>
        </h6>

        <p>
          A portal for Master Dealers to manage their own downstream network: onboarding sub-dealers, controlling which products they can sell, adjusting margins, and reviewing performance and orders across their hierarchy.
        </p>

        <ul class="flex flex-wrap gap-2 mt-2">
          <li class="badge badge-primary print:!bg-transparent">
            <AngularIcon />
            <span>Angular 20</span>
          </li>

          <li class="badge badge-primary print:!bg-transparent">
            <TailwindIcon />
            <span>TailwindCSS 4</span>
          </li>

          <li class="badge badge-primary print:!bg-transparent">
            <NgZorroIcon />
            <span>Ng Zorro</span>
          </li>

          <li class="badge badge-primary print:!bg-transparent">
            <SignalrIcon />
            <span>SignalR</span>
          </li>
        </ul>
      </li>

      <li>
        <h6 class="mb-1">
          <a
            target="_blank"
            href="https://khotot.vn/"
            class="text-primary"
          >
            Sub Dealer Client
          </a>
        </h6>

        <p>
          The public e-commerce experience where customers browse cameras, compare specs, view dealer-specific pricing, and place orders that are routed into the dealer network.
        </p>

        <ul class="flex flex-wrap gap-2 mt-2">
          <li class="badge badge-primary print:!bg-transparent">
            <NextIcon />
            <span>Next 15</span>
          </li>

          <li class="badge badge-primary print:!bg-transparent">
            <TailwindIcon />
            <span>TailwindCSS 4</span>
          </li>

          <li class="badge badge-primary print:!bg-transparent">
            <HeroUiIcon />
            <span>Hero UI 2</span>
          </li>

          <li class="badge badge-primary print:!bg-transparent">
            <SignalrIcon />
            <span>SignalR</span>
          </li>
        </ul>
      </li>

      <li>
        <h6 class="mb-1">
          <a class="text-primary">
            DSS API <small class="text-neutral">(not my work)</small>
          </a>
        </h6>

        <p>
          A RESTful API that provides data for the website and the dashboard.
        </p>

        <ul class="flex flex-wrap gap-2 mt-4">
          <li class="badge badge-primary print:!bg-transparent">
            <DotnetIcon />
            <span>Net Core</span>
          </li>

          <li class="badge badge-primary print:!bg-transparent">
            <SqlIcon />
            <span>SQL Server</span>
          </li>

          <li class="badge badge-primary print:!bg-transparent">
            <SignalrIcon />
            <span>SignalR</span>
          </li>
        </ul>
      </li>
    </ul>
  </article>
</Project>
