---
import Section from '@/components/Section.astro';

import PersonalMuabalo from './projects/Per-Muabalo.astro';
import PersonalTaproStock from './projects/Per-TaproStock.astro';
import PersonalGomoku from './projects/Per-Gomoku.astro';
import PersonalLoveAlarm from './projects/Per-LoveAlarm.astro';
import PersonalLaSoTuVi from './projects/Per-LaSoTuVi.astro';
import PersonalPatchHub from './projects/Per-PatchHub.astro';
import PerDssSalePlatform from './projects/Per-DssSalePlatform.astro';
---

<Section title="Personal & Freelance Projects">
  <div class="grid gap-8">
    <div>
      <div class="grid gap-8">
        <div>
          <div class="space-y-2 rounded-md p-2">
            <PerDssSalePlatform />
          </div>
        </div>

        <div class="print:hidden!">
          <div class="space-y-2 rounded-md p-2">
            <PersonalMuabalo />
          </div>
        </div>

        <div class="print:hidden!">
          <div class="space-y-2 rounded-md p-2">
            <PersonalPatchHub />
          </div>
        </div>
      </div>
    </div>

    <div>
      <div class="grid gap-8">
        <div class="space-y-2 rounded-md p-2">
          <PersonalTaproStock />
        </div>

        <div class="print:hidden!">
          <div class="space-y-2 rounded-md p-2">
            <PersonalGomoku />
          </div>
        </div>

        <div class="print:hidden!">
          <div class="space-y-2 rounded-md p-2">
            <PersonalLoveAlarm />
          </div>
        </div>

        <div class="print:hidden!">
          <div class="space-y-2 rounded-md p-2">
            <PersonalLaSoTuVi />
          </div>
        </div>
      </div>
    </div>
  </div>
</Section>
