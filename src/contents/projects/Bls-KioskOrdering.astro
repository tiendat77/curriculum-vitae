---
import Project from '@/components/Project.astro';

import AngularIcon from "@/icons/angular.astro";
import TailwindIcon from "@/icons/tailwind.astro";
---

<Project
  name="BLogic Kiosk Ordering"
  type="BLogic Systems"
  year="2024 - Present"
  link='Kiosk'
  href='https://order.blogicsystems.com/kiosk-wiki/posts/getting-started-with-blogickiosk/'
>
  <article class="mt-2 text-sm">
    <p>
      Self‑service ordering kiosks for quick‑service restaurants, built to shorten queues and reduce ordering mistakes. Guests build and pay for their orders on large touchscreen devices, while the app pushes structured tickets straight into the restaurant’s back‑of‑house systems.
    </p>

    <ul class="flex flex-wrap gap-2 mt-2">
      <li class="badge badge-primary print:!bg-transparent">
        <AngularIcon />
        <span>Angular 13</span>
      </li>

      <li class="badge badge-primary print:!bg-transparent">
        <TailwindIcon />
        <span>TailwindCSS</span>
      </li>

      <li class="badge badge-primary print:!bg-transparent">
        <span>PAX Integration</span>
      </li>
    </ul>
  </article>
</Project>
