---
import Project from '@/components/Project.astro';

import AngularIcon from "@/icons/angular.astro";
import TailwindIcon from "@/icons/tailwind.astro";
import SignalrIcon from '@/icons/signalr.astro';
import MaterialIcon from '@/icons/material.astro';
import CapacitorIcon from '@/icons/capacitor.astro';
---

<Project
  name="BLogic Sensa Booking"
  link="sensabooking.com"
  href="https://sensabooking.com/"
  type="BLogic Systems"
  year="2022 - Present"
>
  <article class="mt-2 text-sm">
    <p>
      A booking platform for salons that replaces phone calls and notebooks with unified online scheduling. It handles multi‑location availability, client self‑booking, reminders, and payment flows, while salon owners manage services, staff calendars, and business performance from a central dashboard.
    </p>

    <p>
      I led the front-end implementation from the ground up, setting up the projects, defining the architecture, and serving as the main developer across the booking suite.
    </p>

    <p>
      Core sub-projects:
    </p>

    <ul class="flex flex-col gap-4 list-disc pl-4">
      <li>
        <h6 class="mb-1">
          <a class="text-primary">
            Sensa Booking Dashboard
          </a>
        </h6>

        <p>
          Back‑office dashboard where salon owners configure services, manage staff schedules, track appointments, and review revenue and utilization.
        </p>
      </li>

      <li>
        <h6 class="mb-1">
          <a class="text-primary">
            Sensa Booking Page
          </a>
        </h6>

        <p>
          Client‑facing booking flow for discovering salons, browsing services, and booking appointments online without calling the front desk.
        </p>
      </li>

      <li>
        <h6 class="mb-1">
          <a class="text-primary">
            Sensa Booking Check In
          </a>
        </h6>

        <p>
          A lightweight app for in‑store check‑in that lets clients announce their arrival and confirms them into the queue.
        </p>
      </li>

      <li>
        <h6 class="mb-1">
          <a class="text-primary">
            Sensa Booking Wiki
          </a>
        </h6>

        <p>
          Documentation site for salons and staff with setup guides, FAQs, and feature explanations.
        </p>
      </li>

      <li>
        <h6 class="mb-1">
          <a class="text-primary">
            Sensa Booking Admin
          </a>
        </h6>

        <p>
          Internal admin for the BLogic team to manage tenants, plans, platform configuration, and billing.
        </p>
      </li>
    </ul>

    <ul class="flex flex-wrap gap-2 mt-2">
      <li class="badge badge-primary print:!bg-transparent">
        <AngularIcon />
        <span>Angular 13</span>
      </li>

      <li class="badge badge-primary print:!bg-transparent">
        <TailwindIcon />
        <span>TailwindCSS</span>
      </li>

      <li class="badge badge-primary print:!bg-transparent">
        <MaterialIcon />
        <span>Material</span>
      </li>

      <li class="badge badge-primary print:!bg-transparent">
        <SignalrIcon />
        <span>SignalR</span>
      </li>

      <li class="badge badge-primary print:!bg-transparent">
        <CapacitorIcon />
        <span>CapacitorJS</span>
      </li>
    </ul>
  </article>
</Project>
