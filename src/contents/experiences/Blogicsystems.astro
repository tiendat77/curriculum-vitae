---
import Timeline from "@/components/Timeline.astro";

import AngularIcon from "@/icons/angular.astro";
import MaterialIcon from "@/icons/material.astro";
import NxIcon from "@/icons/nx.astro";
import AstroIcon from "@/icons/astro.astro";
import DotNetIcon from "@/icons/dotnet.astro";
import SigalrIcon from "@/icons/signalr.astro";
import SqlIcon from "@/icons/sql.astro";
import JenkinsIcon from "@/icons/jenkins.astro";
import DockerIcon from "@/icons/docker.astro";
import TailwindIcon from "@/icons/tailwind.astro";
import TypescriptIcon from "@/icons/typescript.astro";
import CapacitorIcon from "@/icons/capacitor.astro";
---
<!-- TO: 2026-02-26 -->
<Timeline from="2022-05-02" to="2026-03-01">
  <h3>
    <span>Front-end Developer</span>

    <span>@</span>

    <a
      target="_blank"
      href="https://www.blogicsystems.com/"
      class="group/link text-primary"
    >
      BLogic Systems

      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 20 20"
        fill="currentColor"
        aria-hidden="true"
        class="ml-1 print:hidden transition-transform translate-y-px icon-size-4 shrink-0 group-hover/link:-translate-y-1 group-hover/link:translate-x-1 group-focus-visible/link:-translate-y-1 group-focus-visible/link:translate-x-1 motion-reduce:transition-none"
      >
        <path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 001.06 0l7.22-7.22v5.69a.75.75 0 001.5 0v-7.5a.75.75 0 00-.75-.75h-7.5a.75.75 0 000 1.5h5.69l-7.22 7.22a.75.75 0 000 1.06z" clip-rule="evenodd"></path>
      </svg>
    </a>
  </h3>

  <div class="mt-2 text-xs text-neutral">
    Restaurant management & Booking Platform - Thu Duc, Ho Chi Minh City
  </div>

  <div class="flex flex-col gap-4 mt-6 text-sm">
    <div class="flex flex-col gap-2">
      <ul class="flex flex-col gap-2 pl-4 list-disc">
        <li>
          Key contributor across multiple products (Angular 12-20): scheduling and online booking, multipurpose reporting, online ordering, kiosks, waitlists, license management, and admin tools.
        </li>
        <li>
          Used Capacitor and Ionic to build and deploy mobile applications to Google Play and the App Store.
        </li>
        <li>
          Mentored 4 junior developers, led code reviews, and drove front-end standards and practices.
        </li>
        <li>
          Solved complex restaurant business logic beyond simple ordering, focusing on high-impact features and system automation.
        </li>
        <li>
          Improved front-end performance by cutting the initial bundle from 12MB to 3MB and first-load time from 12s to 1.66s. Accessibility improvements included keyboard navigation, focus management, and screen reader support.
        </li>
        <li>
          Owned front-end technical design, evolving and maintaining scalable architectures from scratch, setting up projects that support multiple teams and products.
        </li>
        <li>
          Built and managed CI/CD with Jenkins and Docker from the ground up for 5 products, cutting deployment from about 20 minutes of manual, error-prone work with downtime risk to 5 minutes, fully automated.
        </li>
      </ul>
    </div>

    <div class="flex flex-col gap-2">
      <h4>Tech stack:</h4>

      <ul class="flex flex-wrap gap-2">
        <li class="badge badge-primary print:bg-transparent!">
          <AngularIcon />
          <span>Angular</span>
        </li>

        <li class="badge badge-primary print:bg-transparent!">
          <MaterialIcon />
          <span>Material</span>
        </li>

        <li class="badge badge-primary print:bg-transparent!">
          <NxIcon />
          <span>Nx</span>
        </li>

        <li class="badge badge-primary print:bg-transparent!">
          <TypescriptIcon />
          <span>TypeScript</span>
        </li>

        <li class="badge badge-primary print:bg-transparent!">
          <TailwindIcon />
          <span>Tailwind CSS</span>
        </li>

        <li class="badge badge-primary print:bg-transparent!">
          <AstroIcon />
          <span>Astro</span>
        </li>

        <li class="badge badge-primary print:bg-transparent!">
          <CapacitorIcon />
          <span>Capacitor</span>
        </li>

        <li class="badge badge-primary print:bg-transparent!">
          <DotNetIcon />
          <span>.NET Core</span>
        </li>

        <li class="badge badge-primary print:bg-transparent!">
          <SigalrIcon />
          <span>SignalR</span>
        </li>

        <li class="badge badge-primary print:bg-transparent!">
          <SqlIcon />
          <span>SQL Server</span>
        </li>

        <li class="badge badge-primary print:bg-transparent!">
          <DockerIcon />
          <span>Docker</span>
        </li>

        <li class="badge badge-primary print:bg-transparent!">
          <JenkinsIcon />
          <span>Jenkins</span>
        </li>

      </ul>
    </div>
  </div>
</Timeline>
