---
import Timeline from "@/components/Timeline.astro";

import AngularIcon from "@/icons/angular.astro";
import MaterialIcon from "@/icons/material.astro";
import NodeJsIcon from "@/icons/node.astro";
import MongoIcon from "@/icons/mongo.astro";
import TypescriptIcon from "@/icons/typescript.astro";
import CapacitorIcon from "@/icons/capacitor.astro";
---

<Timeline from="2019-09-03" to="2022-03-30">
  <h3>
    <span>Front-end Developer</span>

    <span>@</span>

    <a
      target="_blank"
      href="https://leanwell.co/"
      class="group/link text-primary"
    >
      Leanwell Tech

      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 20 20"
        fill="currentColor"
        aria-hidden="true"
        class="ml-1 print:hidden transition-transform translate-y-px icon-size-4 shrink-0 group-hover/link:-translate-y-1 group-hover/link:translate-x-1 group-focus-visible/link:-translate-y-1 group-focus-visible/link:translate-x-1 motion-reduce:transition-none"
      >
        <path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 001.06 0l7.22-7.22v5.69a.75.75 0 001.5 0v-7.5a.75.75 0 00-.75-.75h-7.5a.75.75 0 000 1.5h5.69l-7.22 7.22a.75.75 0 000 1.06z" clip-rule="evenodd"></path>
      </svg>
    </a>
  </h3>

  <div class="mt-2 text-xs text-neutral">
    Manufacturing operations management - District 7, Ho Chi Minh City
  </div>

  <div class="flex flex-col gap-4 mt-6 text-sm">
    <div class="flex flex-col gap-2">
      <ul class="flex flex-col gap-2 pl-4 list-disc">
        <li>
          Collaborated in a small, high-ownership team to deliver and
          evolve the Leanwell MOM/MES platform for 2 clients across 3 factories.
        </li>
        <li>
          Accelerated my front-end development skills by learning Angular
          from senior mentors and assisting with the migration from
          Angular 6 to Angular 9.
        </li>
        <li>
          Connected the platform with hundreds of IoT devices across hundreds of
          production lines to stream production data in real time, enabling more automated and data-driven
          decisions.
        </li>
        <li>
          Partnered with clients to turn operational pain points into
          product features across HR, payroll, meal tickets, and
          production analytics.
        </li>
        <li>
          Authored technical and user-facing documentation in Markdown
          to keep knowledge shareable and easy to integrate with modern
          tools.
        </li>
        <li>
          Built and shipped a mobile companion app with Ionic framework.
        </li>
      </ul>
    </div>

    <div class="flex flex-col gap-2">
      <h4>Tech stack:</h4>

      <ul class="flex flex-wrap gap-2">
        <li class="badge badge-primary print:bg-transparent!">
          <AngularIcon />
          <span>Angular</span>
        </li>

        <li class="badge badge-primary print:bg-transparent!">
          <MaterialIcon />
          <span>Material</span>
        </li>

        <li class="badge badge-primary print:bg-transparent!">
          <TypescriptIcon />
          <span>TypeScript</span>
        </li>

        <li class="badge badge-primary print:bg-transparent!">
          <NodeJsIcon />
          <span>Node.js</span>
        </li>

        <li class="badge badge-primary print:bg-transparent!">
          <CapacitorIcon />
          <span>Ionic</span>
        </li>

        <li class="badge badge-primary print:bg-transparent!">
          <MongoIcon />
          <span>MongoDB</span>
        </li>

      </ul>
    </div>
  </div>
</Timeline>
