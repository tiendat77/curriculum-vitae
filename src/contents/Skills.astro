---
import Section from "@/components/Section.astro";

import AngularIcon from "@/icons/angular-color.astro";
import AstroIcon from "@/icons/astro-color.astro";
import TailwindIcon from "@/icons/tailwind-color.astro";
import TypescriptIcon from "@/icons/typescript-color.astro";
import JavascriptIcon from "@/icons/javascript-color.astro";
import NodeJsIcon from "@/icons/node-color.astro";
import UbuntuIcon from "@/icons/ubuntu-color.astro";
import DockerIcon from "@/icons/docker-color.astro";
import JenkinsIcon from "@/icons/jenkins-color.astro";
import FigmaIcon from "@/icons/figma-color.astro";
import InscapeIcon from "@/icons/inkscape-color.astro";
import ArduinoIcon from "@/icons/arduino-color.astro";
import NginxIcon from "@/icons/nginx-color.astro";
import GitIcon from "@/icons/git-color.astro";
import VsCodeIcon from "@/icons/vs-code-color.astro";
import ReactIcon from "@/icons/react-color.astro";
import NextjsIcon from "@/icons/nextjs-color.astro";
import CursorIcon from "@/icons/cursor.astro";
import CapacitorIcon from "@/icons/capacitor.astro";
import NxIcon from "@/icons/nx.astro";
import SignalrIcon from "@/icons/signalr.astro";

// Single source for both the web badges and the print-only plain-text list (ATS-friendly).
const groups = [
  {
    title: "Languages and frameworks",
    skills: [
      { name: "Angular", Icon: AngularIcon },
      { name: "React", Icon: ReactIcon },
      { name: "Next.js", Icon: NextjsIcon },
      { name: "Astro", Icon: AstroIcon },
      { name: "Tailwind CSS", Icon: TailwindIcon },
      { name: "JavaScript", Icon: JavascriptIcon },
      { name: "TypeScript", Icon: TypescriptIcon },
      { name: "Node.js", Icon: NodeJsIcon },
      { name: "Ionic" },
      { name: "Capacitor", Icon: CapacitorIcon },
    ],
  },
  {
    title: "Tools",
    skills: [
      { name: "VS Code", Icon: VsCodeIcon },
      { name: "Cursor", Icon: CursorIcon },
      { name: "Git", Icon: GitIcon },
      { name: "Nx", Icon: NxIcon },
      { name: "SignalR", Icon: SignalrIcon },
      { name: "Ubuntu", Icon: UbuntuIcon },
      { name: "Docker", Icon: DockerIcon },
      { name: "Nginx", Icon: NginxIcon },
      { name: "Jenkins", Icon: JenkinsIcon },
      { name: "Figma", Icon: FigmaIcon },
      { name: "Inkscape", Icon: InscapeIcon },
      { name: "Arduino", Icon: ArduinoIcon },
    ],
  },
];
---

<Section title="Skills">
  <div class="grid gap-8">
    {groups.map(({ title, skills }) => (
      <div class="break-inside-avoid">
        <h4 class="mb-4 print:mb-1!">{title}</h4>

        <ul class="flex flex-wrap gap-2 mt-2 print:hidden">
          {skills.map(({ name, Icon }) => (
            <li class="badge badge-lg">
              {Icon && <Icon />}
              <span class="font-semibold">{name}</span>
            </li>
          ))}
        </ul>

        <p class="hidden mb-0! text-sm print:block">
          {skills.map((skill) => skill.name).join(", ")}
        </p>
      </div>
    ))}
  </div>
</Section>
