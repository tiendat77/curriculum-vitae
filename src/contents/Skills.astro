---
import Section from "@/components/Section.astro";

// `core` skills render emphasised (bold, primary colour).
// Everything is real text (comma separated) so ATS parsers read it as-is.
const groups = [
  {
    title: "Frontend",
    skills: [
      { name: "Angular", core: true },
      { name: "TypeScript", core: true },
      { name: "React", core: true },
      { name: "Tailwind CSS", core: true },
      { name: "JavaScript" },
      { name: "Next.js" },
      { name: "Astro" },
    ],
  },
  {
    title: "Mobile",
    skills: [
      { name: "React Native", core: true },
      { name: "NativeWind" },
      { name: "Capacitor" },
      { name: "Ionic" },
    ],
  },
  {
    title: "Architecture & state",
    skills: [
      { name: "Nx", core: true },
      { name: "Feature-Sliced Design" },
      { name: "TanStack Query" },
      { name: "Zustand" },
    ],
  },
  {
    title: "Backend & DevOps",
    skills: [
      { name: "Node.js" },
      { name: "Docker" },
      { name: "Jenkins" },
    ],
  },
  {
    title: "Tools",
    skills: [
      { name: "Git" },
      { name: "Figma" },
      { name: "Claude Code" },
      { name: "Antigravity" },
    ],
  },
];
---

<Section title="Skills">
  <dl class="flex flex-col gap-2 mb-0 text-sm">
    {groups.map(({ title, skills }) => (
      <div class="grid grid-cols-[9rem_1fr] gap-4 break-inside-avoid">
        <dt class="font-semibold text-neutral">{title}</dt>

        <dd class="m-0">
          {skills.map(({ name, core }, index) => (
            <>
              <span class:list={[core && "font-semibold text-primary"]}>{name}</span>{index < skills.length - 1 && ", "}
            </>
          ))}
        </dd>
      </div>
    ))}
  </dl>
</Section>
