---
import Project from '@/components/Project.astro';

import AngularIcon from "@/icons/angular.astro";
import TailwindIcon from "@/icons/tailwind.astro";
---

<Project
  name="BLogic Online Ordering"
  type="BLogic Systems"
  year="2024 - Present"
>
  <article class="mt-2 text-sm">
    <p>
      Online ordering for restaurants that replaces phone orders and walk‑ins with QR-based, self‑service flows. Guests browse the live menu, place and pay for orders on their phones, while integrations with the restaurant POS and payment providers keep tickets, payments, and inventory in sync end to end.
    </p>

    <ul class="flex flex-wrap gap-2 mt-2">
      <li class="badge badge-primary print:!bg-transparent">
        <AngularIcon />
        <span>Angular 15</span>
      </li>

      <li class="badge badge-primary print:!bg-transparent">
        <TailwindIcon />
        <span>TailwindCSS</span>
      </li>

      <li class="badge badge-primary print:!bg-transparent">
        <span>Authorize.net</span>
      </li>
    </ul>
  </article>
</Project>
