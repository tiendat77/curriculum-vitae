---
import Project from '@/components/Project.astro';

import AngularIcon from "@/icons/angular.astro";
import TailwindIcon from "@/icons/tailwind.astro";
import MaterialIcon from '@/icons/material.astro';
---

<Project
  name="BLogic Licenses Management System"
  link=""
  href=""
  type="BLogic Systems"
  year="2022 - Present"
>
  <article class="mt-2 text-sm">
    <p>
      Internal license management for all BLogic products, replacing spreadsheets and manual tracking with a single source of truth. The system records which customers own which modules, enforces entitlements across environments, and gives support and sales teams a clear view of license status and usage.
    </p>

    <ul class="flex flex-wrap gap-2 mt-2">
      <li class="badge badge-primary print:!bg-transparent">
        <AngularIcon />
        <span>Angular 15</span>
      </li>

      <li class="badge badge-primary print:!bg-transparent">
        <TailwindIcon />
        <span>TailwindCSS</span>
      </li>

      <li class="badge badge-primary print:!bg-transparent">
        <MaterialIcon />
        <span>Material</span>
      </li>
    </ul>
  </article>
</Project>
